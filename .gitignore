# Somente estes arquivos e pastas fazem parte da distribuição pública.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/.env.example
!/compose.yaml
!/scripts/
!/docs/
!/examples/
!/vendor/
/vendor/*
!/vendor/README.md
**/.env
