!/.env.example
**/*.log
**/*.zip
**/*.tar
**/*.tar.gz
**/*.jar
**/*.war
**/*.ear
**/*.dmp
**/*.sql
**/*.pem
**/*.key
**/__pycache__/
**/runtime/
**/logs/
**/data/
**/credentials*
**/secrets*
**/chave*.txt
**/licenca*.txt
**/license*.dat
**/license*.xml
